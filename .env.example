DATABASE_URL="file:./dev.db"

# Gemini on Vertex AI
# Required: your Google Cloud project ID with Vertex AI enabled.
GOOGLE_CLOUD_PROJECT=""
# Optional: defaults to "global" (recommended — no pricing premium, max availability).
GOOGLE_CLOUD_LOCATION="global"
# Auth: run `gcloud auth application-default login` locally, or set
# GOOGLE_APPLICATION_CREDENTIALS to a service account JSON path.
# GOOGLE_APPLICATION_CREDENTIALS=""

# Reddit verbatim fetcher (free, optional but recommended).
# Research pulls real Reddit comments to ground avatar/angle/concept drafts.
# Anonymous Reddit JSON is now 403-blocked from most IPs, so set up free OAuth:
#   1. Go to https://www.reddit.com/prefs/apps  ->  "create another app"
#   2. Choose type "script", set redirect uri to http://localhost:3000
#   3. Copy the client id (under the app name) and the secret below.
# Without these, research still works (it just skips the Reddit step).
REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""
# Optional UA override (Reddit convention: platform:appid:version (by /u/you)).
# REDDIT_USER_AGENT="web:cellumove-ad-factory:0.1 (by /u/yourname)"

# YouTube Data API v3 — pulls real comment threads into the G2 deep dive.
# Create an API KEY (not the Vertex service account) in the SAME GCP project:
# Console -> APIs & Services -> enable "YouTube Data API v3" -> Credentials ->
# Create API key -> restrict to YouTube Data API. Free within the daily quota.
# Without it, the deep dive just skips the YouTube source.
YOUTUBE_API_KEY=""

# Proxy pool for the web scraper (lib/scraper.ts), optional.
# Used to fetch sources without a clean API (Quora, forums, TikTok captions) and
# to give the anonymous Reddit path a residential IP that won't get 403'd.
# http/https proxies only (no SOCKS). Comma- or space-separated; rotated per request.
# A residential/rotating provider (e.g. a gateway endpoint) is what beats Reddit's edge.
# SCRAPER_PROXIES="http://user:pass@host:port, http://user:pass@host2:port"
# SCRAPER_PROXY="http://user:pass@host:port"
# SCRAPER_USER_AGENT="Mozilla/5.0 (...)"   # override the default browser UA

# Google Drive b-roll indexing (optional) — powers the /broll library and the
# script-accurate b-roll matching in the Designer + Creative-Briefs stages.
# Reuses the SAME service account as Vertex (GOOGLE_APPLICATION_CREDENTIALS_JSON):
#   1. Share your b-roll Drive folder (Viewer) with the service account's client_email.
#   2. Set the folder id(s) below, comma-separated (the part after /folders/ in the Drive URL).
# Without it, everything still works — b-roll suggestions just aren't matched to files.
GOOGLE_DRIVE_BROLL_FOLDER_ID=""

# ── Auth (custom username/password — signed-cookie session gate) ──────────────
# Optional secret used to sign session cookies. Falls back to the service-role key
# if unset, but set a dedicated random value in production (rotating it logs everyone out).
AUTH_SECRET=""

# Teardown2 API — optional, server-side only. Enables importing completed ad
# deconstructions into new Script Studio projects.
# Example: http://127.0.0.1:8011/api/v1
TEARDOWN_API_BASE_URL=""
# Required shared secret validated by Teardown2's private AdFactory endpoints.
# Generate at least 32 random characters and set the same value there as
# ADFACTORY_SHARED_SECRET.
TEARDOWN_INTERNAL_TOKEN=""

# Shopify product catalogue — optional, server-side only.
# Always use the permanent *.myshopify.com domain, never the storefront domain.
SHOPIFY_STORE_DOMAIN="your-store.myshopify.com"
# GraphQL Admin API version. AdFactory defaults to the current stable version below.
SHOPIFY_API_VERSION="2026-07"
# Authentication option A: Admin API access token from an installed custom app.
# The app needs only the read_products scope.
SHOPIFY_ADMIN_ACCESS_TOKEN=""
# Authentication option B: Dev Dashboard client credentials for an organization-owned store.
# Leave these blank when SHOPIFY_ADMIN_ACCESS_TOKEN is set.
SHOPIFY_CLIENT_ID=""
SHOPIFY_CLIENT_SECRET=""
